{
  "Scikit BaseModel Class": {
    "prefix": "sk-basemodel",
    "body": [
      "import os",
      "import pickle",
      "",
      "import pandas as pd",
      "from sklearn.compose import ColumnTransformer",
      "from sklearn.impute import SimpleImputer",
      "from sklearn.pipeline import Pipeline",
      "from sklearn.pipeline import make_pipeline",
      "from sklearn.preprocessing import OneHotEncoder",
      "from sklearn.preprocessing import StandardScaler",
      "from sklearn.feature_selection import SelectFromModel",
      "",
      "",
      "class BaseModel:",
      "    \"\"\"",
      "    Base class for Model",
      "    \"\"\"",
      "    def __init__(self, estimator, method, scorer,",
      "                 feature_selection=False, feature_selection_thr=\"1.5*median\", # remove 50% features",
      "                ):",
      "        \"\"\"",
      "        Method for initializing the model class",
      "        ",
      "        :param **params - dict {parameter=value}",
      "        \"\"\"",
      "        self._input_features = None",
      "        self._output_features = None",
      "        self._pipe = None",
      "        self._model = estimator",
      "        self._method = method",
      "        self._scorer = scorer",
      "        self._feature_selection = feature_selection",
      "        self._feature_selection_thr = feature_selection_thr",
      "",
      "    def fit(self, X, y):",
      "        \"\"\"",
      "        Method for training the model",
      "",
      "        :param X - pd.DataFrame - initial training data set",
      "        :param y - pd.Series - target variable",
      "        \"\"\"",
      "        cat_cols = X.select_dtypes(include=['object']).columns.tolist()",
      "        num_cols = X.select_dtypes(include=['float', 'int']).columns.tolist()",
      "",
      "        cat_prep = make_pipeline(",
      "            SimpleImputer(strategy='most_frequent'),",
      "            OneHotEncoder(handle_unknown='ignore', sparse_output=False))",
      "",
      "        num_prep = make_pipeline(",
      "            SimpleImputer(strategy='mean'),",
      "            StandardScaler())",
      "",
      "        column_transforms = ColumnTransformer([",
      "            ('cat', cat_prep, cat_cols),",
      "            ('num', num_prep, num_cols),",
      "            ],",
      "            remainder='drop',",
      "            sparse_threshold=0.)",
      "",
      "        feature_selection_step = (",
      "            \"feature_selection\",",
      "            SelectFromModel(",
      "                estimator=self._model,",
      "                threshold=self._feature_selection_thr,",
      "            ),",
      "        )",
      "",
      "        pipeline_steps = [('column', column_transforms)]",
      "        ",
      "        if self._feature_selection:",
      "            pipeline_steps.append(feature_selection_step)",
      "",
      "        # your model as final step",
      "        pipeline_steps.append(('model', self._model))",
      "        ",
      "        # describe pipeline",
      "        self._pipe = Pipeline(pipeline_steps)",
      "",
      "        self._input_features = cat_cols + num_cols",
      "        _X = X[self.get_input_features()]",
      "        self._pipe.fit(_X, y)",
      "",
      "        self._output_features = self._pipe[:-1].get_feature_names_out()",
      "        return self._pipe",
      "",
      "    def get_importances(self):",
      "        \"\"\"",
      "        Method returns the importance of features",
      "        \"\"\"",
      "        if hasattr(self._model, 'coef_'):",
      "            imp = self._pipe[-1].coef_.ravel()",
      "        elif hasattr(self._model, 'feature_importances_'):",
      "            imp = self._pipe[-1].feature_importances_",
      "        else:",
      "            raise NotImplementedError()",
      "            ",
      "        return pd.Series(imp, index=self.get_output_features()).round(4).sort_values(ascending=False)",
      "    ",
      "    def get_input_features(self):",
      "        \"\"\"",
      "        The method returns the list",
      "        of original features before data transformation",
      "        \"\"\"",
      "        return self._input_features",
      "",
      "    def get_output_features(self):",
      "        \"\"\"",
      "        The method returns the list",
      "        of output features after transformation (used in model training)",
      "        \"\"\"",
      "        return self._output_features",
      "",
      "    def transform(self, X):",
      "        \"\"\"",
      "        A method for producing transformed features",
      "        that go to the input of the model",
      "",
      "        :param X - pd.DataFrame - input dataset",
      "        \"\"\"",
      "        _X = X[self.get_input_features()]",
      "        return self._pipe[:-1].transform(_X)",
      "",
      "    def save(self, filepath):",
      "        \"\"\"",
      "        The method saves the Model object to a file",
      "",
      "        :param filepath - str - path to the file",
      "        \"\"\"",
      "        dirname = os.path.dirname(filepath)",
      "        if not os.path.exists(dirname):",
      "            os.makedirs(dirname, exist_ok=True)",
      "",
      "        with open(filepath, 'wb') as f:",
      "            pickle.dump(self, f)",
      "",
      "    @classmethod",
      "    def load(cls, filepath):",
      "        \"\"\"",
      "        The method loads Model object from a file",
      "",
      "        :param filepath - str - path to file",
      "        \"\"\"",
      "        with open(filepath, 'rb') as f:",
      "            obj = pickle.load(f)",
      "        return obj",
      "        ",
      "    def score(self, X, y):",
      "        \"\"\"",
      "        The method returns the quality metric of the model on the dataset",
      "",
      "        :param X - pd.DataFrame - source dataset for training",
      "        :param y - pd.Series - target variable",
      "        \"\"\"",
      "        _X = X[self.get_input_features()]",
      "        y_hat = self.predict(_X)",
      "        return round(self._scorer(y, y_hat), 4)",
      "",
      "    def predict(self, X):",
      "        \"\"\"",
      "        A method to obtain a probability estimate of a class",
      "",
      "        :param X - pd.DataFrame - initial data set for training",
      "        \"\"\"",
      "",
      "        _X = X[self.get_input_features()]",
      "        ",
      "        if self._method == 'predict_proba':",
      "            y_pred = self._pipe.predict_proba(_X)[:, 1]",
      "        elif self._method == 'predict':",
      "            y_pred = self._pipe.predict(_X)",
      "        else:",
      "            raise NotImplementedError()",
      "",
      "        return y_pred",
      "",
      "",
      "from sklearn.linear_model import LogisticRegression",
      "from sklearn.metrics import roc_auc_score",
      "",
      "",
      "clf = BaseModel(estimator=LogisticRegression(C=3, max_iter=1000, random_state=42),",
      "                method='predict_proba',",
      "                scorer=roc_auc_score)",
      ""
    ],
    "description": "Base class for model"
  }
}
